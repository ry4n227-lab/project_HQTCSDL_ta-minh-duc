generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MERCHANT
}

enum TransactionType {
  EARN
  REDEEM
  ADJUST
}

model Merchant {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @db.VarChar(150)
  email       String     @unique @db.VarChar(254)
  phone       String?    @db.VarChar(30)
  address     String?    @db.VarChar(255)
  status      String     @default("ACTIVE") @db.VarChar(20)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  users       User[]
  customers   Customer[]
  transactions Transaction[]

  @@index([status])
  @@index([createdAt])
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(254)
  passwordHash String
  fullName     String   @db.VarChar(150)
  role         UserRole @default(MERCHANT)
  merchantId   String?  @db.Uuid
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  merchant     Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  @@index([merchantId])
  @@index([role, isActive])
}

model Customer {
  id          String   @id @default(uuid()) @db.Uuid
  merchantId  String   @db.Uuid
  externalRef String?  @db.VarChar(100)
  fullName    String   @db.VarChar(150)
  email       String?  @db.VarChar(254)
  phone       String?  @db.VarChar(30)
  points      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([merchantId, externalRef])
  @@index([merchantId, createdAt])
  @@index([merchantId, email])
  @@index([merchantId, phone])
}

model Transaction {
  id          String          @id @default(uuid()) @db.Uuid
  merchantId  String          @db.Uuid
  customerId  String          @db.Uuid
  type        TransactionType
  points      Int
  description String?         @db.VarChar(500)
  reference   String?         @db.VarChar(120)
  createdAt   DateTime        @default(now())
  merchant    Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer    Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([merchantId, createdAt(sort: Desc)])
  @@index([customerId, createdAt(sort: Desc)])
  @@index([merchantId, type, createdAt(sort: Desc)])
}
